{{!
    Frontpage section.
}}

<div class="row">
    <div class="col-12 col-md-4">
        <div class="br-card main-inner">
            <div class="card-content">
                <h1><i class="fas fa-users" style="font-size:larger; margin: 0 auto; width: 100%;"></i></h1>
                <h6 style="text-align:center">{{teacherlabel}}</h6>
                <ul class="list-unstyled d-flex flex-wrap">
                {{#teachers}}
                    <li class="text-center mr-3 mb-2">
                        <img src="{{picture}}" alt="{{fullname}}" class="rounded-circle d-block mx-auto mb-1" width="60" height="60" style="object-fit:cover;">
                        <span class="small">{{fullname}}</span>
                    </li>
                {{/teachers}}
                {{^teachers}}
                    <li>{{#str}} no_teacher, theme_govbrds {{/str}}</li>
                {{/teachers}}
                </ul>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="br-card main-inner">
            <div class="card-content">
                <div>
                    <h1><i class="fas fa-calendar" style="font-size:larger; margin: 0 auto; width: 100%;"></i></h1>
                    <h6 style="text-align:center">{{#str}} course_period, theme_govbrds {{/str}}</h6>
               </div>
               <p class="lead" style="text-align:center; font-size:1.25rem;">
                {{{startdate}}}
                {{#enddate}}
                 <br>{{#str}} to, theme_govbrds {{/str}} {{{enddate}}}
                {{/enddate}}
                </p>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="br-card main-inner">
            <div class="card-content">
                <h1><i class="fas fa-link" style="font-size:larger; margin: 0 auto; width: 100%;"></i></h1>
                <h6 style="text-align:center">{{#str}} related_courses, theme_govbrds {{/str}}</h6>
                <ul>
                {{#relatedcourses}}
                    <li>{{ fullname }}</li>
                {{/relatedcourses}}
                {{^relatedcourses}}
                    <li>{{#str}} no_related_course, theme_govbrds {{/str}}</li>
                {{/relatedcourses}}
                </ul>
            </div>
        </div>
    </div>
</div>
