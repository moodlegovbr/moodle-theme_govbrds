{{!
    @template theme_govbrds/sections_tree_columns

    Course tree columns section (teachers, period, related courses).

    Example context (json):
    {"teacherlabel": "Teachers", "teachers": [], "startdate": "2024-01-01", "relatedcourses": []}
}}

<div class="row">
    <div class="col-12 col-md-4">
        <div class="br-card main-inner">
            <div class="card-content">
                <div aria-hidden="true"><i class="fas fa-users" style="font-size:larger; margin: 0 auto; width: 100%;"></i></div>
                <h6 style="text-align:center">{{teacherlabel}}</h6>
                <ul class="list-unstyled d-flex flex-wrap">
                {{#teachers}}
                    <li class="lead" style="text-align:center; font-size:1.25rem;">{{fullname}}</li>
                {{/teachers}}
                {{^teachers}}
                    <li class="lead" style="text-align:center; font-size:1.25rem;">{{#str}} no_teacher, theme_govbrds {{/str}}</li>
                {{/teachers}}
                </ul>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="br-card main-inner">
            <div class="card-content">
                <div>
                    <div aria-hidden="true"><i class="fas fa-calendar" style="font-size:larger; margin: 0 auto; width: 100%;"></i></div>
                    <h6 style="text-align:center">{{#str}} course_period, theme_govbrds {{/str}}</h6>
               </div>
               <p class="lead" style="text-align:center; font-size:1.25rem;">
                {{{startdate}}}
                {{#enddate}}
                 <br>{{#str}} until, theme_govbrds {{/str}} {{{enddate}}}
                {{/enddate}}
                </p>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="br-card main-inner">
            <div class="card-content">
                <div aria-hidden="true"><i class="fas fa-link" style="font-size:larger; margin: 0 auto; width: 100%;"></i></div>
                <h6 style="text-align:center">{{#str}} related_courses, theme_govbrds {{/str}}</h6>
                <ul class="list-unstyled d-flex flex-wrap">
                {{#relatedcourses}}
                    <li class="lead" style="text-align:center; font-size:1.25rem;">
                        <a href="{{url}}">{{fullname}}</a>
                    </li>
                {{/relatedcourses}}
                {{^relatedcourses}}
                    <li class="lead" style="text-align:center; font-size:1.25rem;">{{#str}} no_related_course, theme_govbrds {{/str}}</li>
                {{/relatedcourses}}
                </ul>
            </div>
        </div>
    </div>
</div>
